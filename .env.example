# Stripe (Fredagslådan). Hämta nycklarna i Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_live_...
# Valfritt: webhook som mejlar Josefin vid varje betald låda (Stripe → Developers → Webhooks,
# endpoint https://<domän>/api/stripe-webhook, händelse checkout.session.completed).
STRIPE_WEBHOOK_SECRET=whsec_...

# Mejl för förfrågningar (resend.com). Utan nyckel visas en "mejla oss"-länk i stället.
RESEND_API_KEY=re_...
# Valfritt: avsändare (standard "Les Petit Bulles <hemsida@lespetitbulles.se>", domänen är verifierad i Resend).
# Valfritt: mottagare (standard josefin@farmhousesweden.se).
# INQUIRY_TO=josefin@farmhousesweden.se

# Valfritt: sidans adress. Utan den används https://www.lespetitbulles.se i produktion.
NEXT_PUBLIC_SITE_URL=https://www.lespetitbulles.se

# Admin för Josefin (/admin): event, Nytt på hyllan och menyn.
# Lagring: skapa en Vercel Blob-lagring (public) i projektet, då läggs BLOB_READ_WRITE_TOKEN till automatiskt.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Lösenordet Josefin loggar in med (minst 10 tecken, gärna en lång fras).
ADMIN_PASSWORD=...
# Slumpad nyckel som signerar inloggningen, minst 32 tecken. Skapa med: openssl rand -hex 32
ADMIN_SESSION_SECRET=...
